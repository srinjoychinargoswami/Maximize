# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Encryption Keys
# These will be automatically stored in device secure storage on first run.
# You can leave these blank to auto-generate, or provide your own.
ENCRYPTION_MASTER_KEY=your-256bit-key-here
ENCRYPTION_IV=your-iv-here
XOR_SECRET_KEY=your-xor-secret-here

# App Environment
APP_ENV=production
